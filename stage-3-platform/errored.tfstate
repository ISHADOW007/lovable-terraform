    {
      "module": "module.jcasc",
      "mode": "managed",
      "type": "kubernetes_config_map",
      "name": "jcasc",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "binary_data": {},
            "data": {
              "credentials.yaml": "credentials:\r\n\r\n  system:\r\n\r\n    domainCredentials:\r\n\r\n      #######################################################\r\n      # Global Credentials\r\n      #######################################################\r\n\r\n      - credentials:\r\n\r\n          ###################################################\r\n          # GitHub Personal Access Token\r\n          ###################################################\r\n\r\n          - usernamePassword:\r\n\r\n              id: github-creds\r\n\r\n              scope: GLOBAL\r\n\r\n              username: \"${GITHUB_USERNAME}\"\r\n\r\n              password: \"${GITHUB_TOKEN}\"\r\n\r\n              description: \"GitHub Credentials\"\r\n\r\n          ###################################################\r\n          # DockerHub\r\n          ###################################################\r\n\r\n          - usernamePassword:\r\n\r\n              id: dockerhub-creds\r\n\r\n              scope: GLOBAL\r\n\r\n              username: \"${DOCKERHUB_USERNAME}\"\r\n\r\n              password: \"${DOCKERHUB_PASSWORD}\"\r\n\r\n              description: \"DockerHub Credentials\"\r\n\r\n          ###################################################\r\n          # SonarQube Token\r\n          ###################################################\r\n\r\n          - string:\r\n\r\n              id: sonar-token\r\n\r\n              scope: GLOBAL\r\n\r\n              secret: \"${SONAR_TOKEN}\"\r\n\r\n              description: \"SonarQube Token\"\r\n\r\n          ###################################################\r\n          # SMTP Password\r\n          ###################################################\r\n\r\n          - usernamePassword:\r\n\r\n              id: smtp-creds\r\n\r\n              scope: GLOBAL\r\n\r\n              username: \"${SMTP_USERNAME}\"\r\n\r\n              password: \"${SMTP_PASSWORD}\"\r\n\r\n              description: \"SMTP Credentials\"\r\n\r\n          \r\n          - usernamePassword:\r\n              id: \"gitops-creds\"\r\n              username: \"${GITOPS_USERNAME}\"\r\n              password: \"${GITOPS_TOKEN}\"\r\n              description: \"GitOps Repository Credentials\"",
              "jenkins.yaml": "jenkins:\r\n\r\n  mode: NORMAL\r\n\r\n  numExecutors: 0\r\n\r\n  scmCheckoutRetryCount: 2\r\n\r\n  quietPeriod: 5\r\n\r\n  slaveAgentPort: 50000\r\n\r\n  noUsageStatistics: true\r\n\r\n  disabledAdministrativeMonitors:\r\n    - \"jenkins.diagnostics.RootUrlNotSetMonitor\"\r\n\r\n  remotingSecurity:\r\n    enabled: true\r\n\r\n  projectNamingStrategy:\r\n    standard: {}\r\n\r\n  markupFormatter:\r\n    plainText: {}\r\n\r\n  primaryView:\r\n    all:\r\n      name: \"All\"",
              "jobs.groovy": "folder(\"Lovable\") {\r\n\r\n    description(\"Lovable CI/CD Pipelines\")\r\n\r\n}\r\n\r\ndef pipelines = [\r\n\r\n    [\r\n        name : \"frontend\",\r\n        script : \"frontend/Jenkinsfile\"\r\n    ],\r\n\r\n    [\r\n        name : \"api-gateway\",\r\n        script : \"api-gateway/Jenkinsfile\"\r\n    ],\r\n\r\n    [\r\n        name : \"account-service\",\r\n        script : \"account-service/Jenkinsfile\"\r\n    ],\r\n\r\n    [\r\n        name : \"config-service\",\r\n        script : \"config-service/Jenkinsfile\"\r\n    ],\r\n\r\n    [\r\n        name : \"workspace-service\",\r\n        script : \"workspace-service/Jenkinsfile\"\r\n    ],\r\n\r\n    [\r\n        name : \"intelligence-service\",\r\n        script : \"intelligence-service/Jenkinsfile\"\r\n    ]\r\n\r\n]\r\n\r\npipelines.each { pipeline -\u003e\r\n\r\n    pipelineJob(\"Lovable/${pipeline.name}\") {\r\n\r\n        description(\"${pipeline.name} Pipeline\")\r\n\r\n        logRotator {\r\n\r\n            daysToKeep(30)\r\n\r\n            numToKeep(20)\r\n        }\r\n\r\n        definition {\r\n\r\n            cpsScm {\r\n\r\n                scm {\r\n\r\n                    git {\r\n\r\n                        remote {\r\n\r\n                            url(\"https://github.com/ISHADOW007/distributed-lovable.git\")\r\n\r\n                            credentials(\"github-creds\")\r\n                        }\r\n\r\n                        branch(\"*/main\")\r\n                    }\r\n                }\r\n\r\n                scriptPath(pipeline.script)\r\n            }\r\n        }\r\n\r\n        triggers {\r\n\r\n            githubPush()\r\n\r\n        }\r\n    }\r\n}",
              "jobs.yaml": "\r\n\r\n\r\njobs:\r\n  - file: /var/jenkins_home/casc_configs/jobs.groovy",
              "kubernetes.yaml": "jenkins:\r\n\r\n  clouds:\r\n\r\n    - kubernetes:\r\n\r\n        name: \"kubernetes\"\r\n\r\n        serverUrl: \"https://kubernetes.default\"\r\n\r\n        namespace: \"jenkins\"\r\n\r\n        jenkinsUrl: \"http://jenkins.jenkins.svc.cluster.local:8080\"\r\n\r\n        jenkinsTunnel: \"jenkins-agent:50000\"\r\n\r\n        skipTlsVerify: true\r\n\r\n        containerCapStr: \"20\"\r\n\r\n        retentionTimeout: 5\r\n\r\n        connectTimeout: 30\r\n\r\n        readTimeout: 30\r\n\r\n        maxRequestsPerHostStr: \"32\"\r\n\r\n        templates:\r\n\r\n          - name: \"default-agent\"\r\n\r\n            label: \"kubernetes\"\r\n\r\n            namespace: \"jenkins\"\r\n\r\n            serviceAccount: \"jenkins\"\r\n\r\n            nodeUsageMode: NORMAL\r\n\r\n            idleMinutes: 5\r\n\r\n            instanceCap: 20\r\n\r\n            yamlMergeStrategy: \"override\"\r\n\r\n            yaml: |\r\n              apiVersion: v1\r\n              kind: Pod\r\n              metadata:\r\n                labels:\r\n                  jenkins: agent\r\n\r\n              spec:\r\n                serviceAccountName: jenkins\r\n                restartPolicy: Never\r\n\r\n                containers:\r\n                  - name: jnlp\r\n                    image: satyamgrao007/lovable-jenkins-agent:latest\r\n                    imagePullPolicy: Always\r\n                    tty: true\r\n                    workingDir: /home/jenkins/agent\r\n\r\n                    args:\r\n                      - $(JENKINS_SECRET)\r\n                      - $(JENKINS_NAME)\r\n\r\n                    resources:\r\n                      requests:\r\n                        cpu: \"500m\"\r\n                        memory: \"1Gi\"\r\n                      limits:\r\n                        cpu: \"2\"\r\n                        memory: \"4Gi\"\r\n\r\n                    volumeMounts:\r\n                      - name: workspace-volume\r\n                        mountPath: /home/jenkins/agent\r\n\r\n                volumes:\r\n                  - name: workspace-volume\r\n                    emptyDir: {}",
              "location.yaml": "jenkins:\r\n\r\n  systemMessage: |\r\n\r\n    ==========================================\r\n           Lovable DevSecOps Platform\r\n    ==========================================\r\n\r\n    Managed by:\r\n      • Terraform\r\n      • Helm\r\n      • JCasC\r\n      • Kubernetes\r\n\r\n    Manual configuration is discouraged.\r\n\r\nunclassified:\r\n\r\n  location:\r\n\r\n    url: \"https://jenkins.snapcart.dev\"\r\n\r\n    adminAddress: \"devops@snapcart.dev\"",
              "security.yaml": "",
              "smtp.yaml": "unclassified:\r\n\r\n  mailer:\r\n\r\n    smtpHost: \"smtp.gmail.com\"\r\n\r\n    authentication:\r\n\r\n      username: \"${SMTP_USERNAME}\"\r\n\r\n      password: \"${SMTP_PASSWORD}\"\r\n\r\n    useSsl: false\r\n\r\n    useTls: true\r\n\r\n    replyToAddress: \"no-reply@snapcart.dev\"",
              "sonarqube.yaml": "tool:\r\n\r\n  sonarRunnerInstallation:\r\n\r\n    installations:\r\n\r\n      - name: \"SonarScanner\"\r\n\r\n        properties:\r\n\r\n          - installSource:\r\n\r\n              installers:\r\n\r\n                - sonarRunnerInstaller:\r\n                    id: \"latest\"\r\n\r\n\r\nunclassified:\r\n\r\n  sonarGlobalConfiguration:\r\n\r\n    buildWrapperEnabled: false\r\n\r\n    installations:\r\n\r\n      - name: \"SonarQube\"\r\n\r\n        serverUrl: \"https://sonarqube.snapcart.dev\"\r\n\r\n        serverAuthenticationToken: \"sonar-token\"\r\n\r\n        webhookSecretId: \"\"",
              "tools.yaml": "tool:\r\n\r\n  git:\r\n\r\n    installations:\r\n\r\n      - name: Default\r\n\r\n        home: git"
            },
