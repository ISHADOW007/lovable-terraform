            "upgrade_install": false,
            "values": [
              "controller:\r\n\r\n  image:\r\n    registry: docker.io\r\n    repository: satyamgrao007/lovable-jenkins-controller\r\n    tag: latest\r\n    pullPolicy: Always\r\n\r\n  serviceType: ClusterIP\r\n\r\n  servicePort: 8080\r\n\r\n  targetPort: 8080\r\n\r\n  numExecutors: 0\r\n\r\n  executorMode: NORMAL\r\n\r\n  javaOpts: \u003e-\r\n    -Djenkins.install.runSetupWizard=false\r\n\r\n  admin:\r\n\r\n    username: admin\r\n\r\n    password: admin\r\n\r\n  resources:\r\n\r\n    requests:\r\n      cpu: 500m\r\n      memory: 1Gi\r\n\r\n    limits:\r\n      cpu: \"2\"\r\n      memory: 4Gi\r\n\r\n  persistence:\r\n\r\n    enabled: true\r\n\r\n    storageClass: gp2\r\n\r\n    size: 20Gi\r\n\r\n    accessMode: ReadWriteOnce\r\n\r\n  initializeOnce: true\r\n\r\n  overwritePlugins: false\r\n\r\n  installLatestPlugins: false\r\n\r\n  installLatestSpecifiedPlugins: false\r\n\r\n  installPlugins: []\r\n\r\n  disableRememberMe: false\r\n\r\n  JCasC:\r\n\r\n    enabled: true\r\n\r\n    defaultConfig: false\r\n\r\n  #########################################################\r\n  # Mount ConfigMap\r\n  #########################################################\r\n\r\n  additionalVolumes:\r\n\r\n    - name: jcasc-config\r\n\r\n      configMap:\r\n\r\n        name: jenkins-jcasc\r\n\r\n  additionalVolumeMounts:\r\n\r\n    - name: jcasc-config\r\n\r\n      mountPath: /var/jenkins_home/casc_configs\r\n\r\n      readOnly: true\r\n\r\n  #########################################################\r\n  # Environment Variables\r\n  #########################################################\r\n\r\n  containerEnv:\r\n\r\n    - name: CASC_JENKINS_CONFIG\r\n      value: /var/jenkins_home/casc_configs\r\n\r\n    - name: JENKINS_ADMIN_USER\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: JENKINS_ADMIN_USER\r\n\r\n    - name: JENKINS_ADMIN_PASSWORD\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: JENKINS_ADMIN_PASSWORD\r\n\r\n    - name: GITHUB_USERNAME\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: GITHUB_USERNAME\r\n\r\n    - name: GITHUB_TOKEN\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: GITHUB_TOKEN\r\n\r\n    - name: DOCKERHUB_USERNAME\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: DOCKERHUB_USERNAME\r\n\r\n    - name: DOCKERHUB_PASSWORD\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: DOCKERHUB_PASSWORD\r\n\r\n    - name: SONAR_TOKEN\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: SONAR_TOKEN\r\n\r\n    - name: SMTP_USERNAME\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: SMTP_USERNAME\r\n\r\n    - name: SMTP_PASSWORD\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: SMTP_PASSWORD\r\n\r\n#########################################################\r\n# Jenkins Agent\r\n#########################################################\r\n\r\nagent:\r\n\r\n  enabled: false\r\n\r\n#########################################################\r\n# RBAC\r\n#########################################################\r\n\r\nrbac:\r\n\r\n  create: false\r\n\r\n#########################################################\r\n# Service Account\r\n#########################################################\r\n\r\nserviceAccount:\r\n\r\n  create: false\r\n\r\n  name: jenkins\r\n\r\n#########################################################\r\n# Network Policy\r\n#########################################################\r\n\r\nnetworkPolicy:\r\n\r\n  enabled: false\r\n\r\n#########################################################\r\n# Persistence\r\n#########################################################\r\n\r\npersistence:\r\n\r\n  enabled: false"
            ],
            "verify": false,
            "version": "5.9.45",
            "wait": true,
            "wait_for_jobs": false
          },
