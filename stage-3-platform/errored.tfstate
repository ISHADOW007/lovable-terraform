            "metadata": {
              "app_version": "2.568.1",
              "chart": "jenkins",
              "first_deployed": 1785644151,
              "last_deployed": 1785644151,
              "name": "jenkins",
              "namespace": "jenkins",
              "notes": "1. Get your 'admin' user password by running:\n  kubectl exec --namespace jenkins -it svc/jenkins -c jenkins -- /bin/cat /run/secrets/additional/chart-admin-password \u0026\u0026 echo\n2. Get the Jenkins URL to visit by running these commands in the same shell:\n  echo http://127.0.0.1:8080\n  kubectl --namespace jenkins port-forward svc/jenkins 8080:8080\n\n3. Login with the password from step 1 and the username: admin\n4. Configure security realm and authorization strategy\n5. Use Jenkins Configuration as Code by specifying configScripts in your values.yaml file, see documentation: http://127.0.0.1:8080/configuration-as-code and examples: https://github.com/jenkinsci/configuration-as-code-plugin/tree/master/demos\n\nFor more information on running Jenkins on Kubernetes, visit:\nhttps://cloud.google.com/solutions/jenkins-on-container-engine\n\nFor more information about Jenkins Configuration as Code, visit:\nhttps://jenkins.io/projects/jcasc/\n\n\n#################################################################################\n######   WARNING: Persistence is disabled!!! You will lose your data when   #####\n######            the Jenkins pod is terminated.                            #####\n#################################################################################\n",
              "revision": 1,
              "values": "{\"agent\":{\"enabled\":false},\"controller\":{\"JCasC\":{\"defaultConfig\":false,\"enabled\":true},\"additionalVolumeMounts\":[{\"mountPath\":\"/var/jenkins_home/casc_configs\",\"name\":\"jcasc-config\",\"readOnly\":true}],\"additionalVolumes\":[{\"configMap\":{\"name\":\"jenkins-jcasc\"},\"name\":\"jcasc-config\"}],\"admin\":{\"password\":\"admin\",\"username\":\"admin\"},\"containerEnv\":[{\"name\":\"CASC_JENKINS_CONFIG\",\"value\":\"/var/jenkins_home/casc_configs\"},{\"name\":\"JENKINS_ADMIN_USER\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"JENKINS_ADMIN_USER\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"JENKINS_ADMIN_PASSWORD\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"JENKINS_ADMIN_PASSWORD\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"GITHUB_USERNAME\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"GITHUB_USERNAME\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"GITHUB_TOKEN\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"GITHUB_TOKEN\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"DOCKERHUB_USERNAME\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"DOCKERHUB_USERNAME\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"DOCKERHUB_PASSWORD\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"DOCKERHUB_PASSWORD\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"SONAR_TOKEN\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"SONAR_TOKEN\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"SMTP_USERNAME\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"SMTP_USERNAME\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"SMTP_PASSWORD\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"SMTP_PASSWORD\",\"name\":\"jenkins-secrets\"}}}],\"disableRememberMe\":false,\"executorMode\":\"NORMAL\",\"image\":{\"pullPolicy\":\"Always\",\"registry\":\"docker.io\",\"repository\":\"satyamgrao007/lovable-jenkins-controller\",\"tag\":\"latest\"},\"initializeOnce\":true,\"installLatestPlugins\":false,\"installLatestSpecifiedPlugins\":false,\"installPlugins\":[],\"javaOpts\":\"-Djenkins.install.runSetupWizard=false\",\"numExecutors\":0,\"overwritePlugins\":false,\"persistence\":{\"accessMode\":\"ReadWriteOnce\",\"enabled\":true,\"size\":\"20Gi\",\"storageClass\":\"gp2\"},\"resources\":{\"limits\":{\"cpu\":\"2\",\"memory\":\"4Gi\"},\"requests\":{\"cpu\":\"500m\",\"memory\":\"1Gi\"}},\"servicePort\":8080,\"serviceType\":\"ClusterIP\",\"targetPort\":8080},\"networkPolicy\":{\"enabled\":false},\"persistence\":{\"enabled\":false},\"rbac\":{\"create\":false},\"serviceAccount\":{\"create\":false,\"name\":\"jenkins\"}}",
