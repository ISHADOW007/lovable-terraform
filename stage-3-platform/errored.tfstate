    {
      "module": "module.jenkins[0]",
      "mode": "managed",
      "type": "helm_release",
      "name": "this",
      "provider": "provider[\"registry.terraform.io/hashicorp/helm\"]",
      "instances": [
        {
          "schema_version": 2,
          "attributes": {
            "atomic": false,
            "chart": "jenkins",
            "cleanup_on_fail": false,
            "create_namespace": false,
            "dependency_update": false,
            "description": null,
            "devel": null,
            "disable_crd_hooks": false,
            "disable_openapi_validation": false,
            "disable_webhooks": false,
            "force_update": false,
            "id": "jenkins",
            "keyring": null,
            "lint": false,
            "manifest": null,
            "max_history": 0,
            "metadata": {
              "app_version": "2.568.2",
              "chart": "jenkins",
              "first_deployed": 1787177720,
              "last_deployed": 1787177720,
              "name": "jenkins",
              "namespace": "jenkins",
              "notes": "1. Get your 'admin' user password by running:\n  kubectl exec --namespace jenkins -it svc/jenkins -c jenkins -- /bin/cat /run/secrets/additional/chart-admin-password \u0026\u0026 echo\n2. Get the Jenkins URL to visit by running these commands in the same shell:\n  echo http://127.0.0.1:8080\n  kubectl --namespace jenkins port-forward svc/jenkins 8080:8080\n\n3. Login with the password from step 1 and the username: admin\n4. Configure security realm and authorization strategy\n5. Use Jenkins Configuration as Code by specifying configScripts in your values.yaml file, see documentation: http://127.0.0.1:8080/configuration-as-code and examples: https://github.com/jenkinsci/configuration-as-code-plugin/tree/master/demos\n\nFor more information on running Jenkins on Kubernetes, visit:\nhttps://cloud.google.com/solutions/jenkins-on-container-engine\n\nFor more information about Jenkins Configuration as Code, visit:\nhttps://jenkins.io/projects/jcasc/\n\n\n#################################################################################\n######   WARNING: Persistence is disabled!!! You will lose your data when   #####\n######            the Jenkins pod is terminated.                            #####\n#################################################################################\n",
              "revision": 1,
              "values": "{\"agent\":{\"enabled\":false},\"controller\":{\"JCasC\":{\"defaultConfig\":false,\"enabled\":true},\"additionalVolumeMounts\":[{\"mountPath\":\"/var/jenkins_home/casc_configs\",\"name\":\"jcasc-config\",\"readOnly\":true}],\"additionalVolumes\":[{\"configMap\":{\"name\":\"jenkins-jcasc\"},\"name\":\"jcasc-config\"}],\"admin\":{\"password\":\"admin\",\"username\":\"admin\"},\"containerEnv\":[{\"name\":\"CASC_JENKINS_CONFIG\",\"value\":\"/var/jenkins_home/casc_configs\"},{\"name\":\"JENKINS_ADMIN_USER\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"JENKINS_ADMIN_USER\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"JENKINS_ADMIN_PASSWORD\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"JENKINS_ADMIN_PASSWORD\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"GITHUB_USERNAME\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"GITHUB_USERNAME\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"GITHUB_TOKEN\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"GITHUB_TOKEN\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"GITOPS_USERNAME\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"GITOPS_USERNAME\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"GITOPS_TOKEN\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"GITOPS_TOKEN\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"DOCKERHUB_USERNAME\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"DOCKERHUB_USERNAME\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"DOCKERHUB_PASSWORD\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"DOCKERHUB_PASSWORD\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"SONAR_TOKEN\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"SONAR_TOKEN\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"SMTP_USERNAME\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"SMTP_USERNAME\",\"name\":\"jenkins-secrets\"}}},{\"name\":\"SMTP_PASSWORD\",\"valueFrom\":{\"secretKeyRef\":{\"key\":\"SMTP_PASSWORD\",\"name\":\"jenkins-secrets\"}}}],\"disableRememberMe\":false,\"executorMode\":\"NORMAL\",\"image\":{\"pullPolicy\":\"Always\",\"registry\":\"docker.io\",\"repository\":\"satyamgrao007/lovable-jenkins-controller\",\"tag\":\"latest\"},\"initializeOnce\":true,\"installLatestPlugins\":false,\"installLatestSpecifiedPlugins\":false,\"installPlugins\":[],\"javaOpts\":\"-Djenkins.install.runSetupWizard=false\",\"numExecutors\":0,\"overwritePlugins\":false,\"persistence\":{\"accessMode\":\"ReadWriteOnce\",\"enabled\":true,\"size\":\"20Gi\",\"storageClass\":\"gp2\"},\"resources\":{\"limits\":{\"cpu\":\"2\",\"memory\":\"4Gi\"},\"requests\":{\"cpu\":\"500m\",\"memory\":\"1Gi\"}},\"servicePort\":8080,\"serviceType\":\"ClusterIP\",\"targetPort\":8080},\"networkPolicy\":{\"enabled\":false},\"persistence\":{\"enabled\":false},\"rbac\":{\"create\":false},\"serviceAccount\":{\"create\":false,\"name\":\"jenkins\"}}",
              "version": "5.9.54"
            },
            "name": "jenkins",
            "namespace": "jenkins",
            "pass_credentials": false,
            "postrender": null,
            "recreate_pods": false,
            "render_subchart_notes": true,
            "replace": false,
            "repository": "https://charts.jenkins.io",
            "repository_ca_file": null,
            "repository_cert_file": null,
            "repository_key_file": null,
            "repository_password": null,
            "repository_username": null,
            "reset_values": false,
            "resources": null,
            "reuse_values": false,
            "set": null,
            "set_list": null,
            "set_sensitive": null,
            "set_wo": null,
            "set_wo_revision": null,
            "skip_crds": false,
            "status": "deployed",
            "take_ownership": false,
            "timeout": 1800,
            "timeouts": null,
            "upgrade_install": false,
            "values": [
              "controller:\r\n\r\n  image:\r\n    registry: docker.io\r\n    repository: satyamgrao007/lovable-jenkins-controller\r\n    tag: latest\r\n    pullPolicy: Always\r\n\r\n  serviceType: ClusterIP\r\n\r\n  servicePort: 8080\r\n\r\n  targetPort: 8080\r\n\r\n  numExecutors: 0\r\n\r\n  executorMode: NORMAL\r\n\r\n  javaOpts: \u003e-\r\n    -Djenkins.install.runSetupWizard=false\r\n\r\n  admin:\r\n\r\n    username: admin\r\n\r\n    password: admin\r\n\r\n  resources:\r\n\r\n    requests:\r\n      cpu: 500m\r\n      memory: 1Gi\r\n\r\n    limits:\r\n      cpu: \"2\"\r\n      memory: 4Gi\r\n\r\n  persistence:\r\n\r\n    enabled: true\r\n\r\n    storageClass: gp2\r\n\r\n    size: 20Gi\r\n\r\n    accessMode: ReadWriteOnce\r\n\r\n  initializeOnce: true\r\n\r\n  overwritePlugins: false\r\n\r\n  installLatestPlugins: false\r\n\r\n  installLatestSpecifiedPlugins: false\r\n\r\n  installPlugins: []\r\n\r\n  disableRememberMe: false\r\n\r\n  JCasC:\r\n\r\n    enabled: true\r\n\r\n    defaultConfig: false\r\n\r\n  #########################################################\r\n  # Mount ConfigMap\r\n  #########################################################\r\n\r\n  additionalVolumes:\r\n\r\n    - name: jcasc-config\r\n\r\n      configMap:\r\n\r\n        name: jenkins-jcasc\r\n\r\n  additionalVolumeMounts:\r\n\r\n    - name: jcasc-config\r\n\r\n      mountPath: /var/jenkins_home/casc_configs\r\n\r\n      readOnly: true\r\n\r\n  #########################################################\r\n  # Environment Variables\r\n  #########################################################\r\n\r\n  containerEnv:\r\n\r\n    - name: CASC_JENKINS_CONFIG\r\n      value: /var/jenkins_home/casc_configs\r\n\r\n    #####################################################\r\n    # Jenkins\r\n    #####################################################\r\n\r\n    - name: JENKINS_ADMIN_USER\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: JENKINS_ADMIN_USER\r\n\r\n    - name: JENKINS_ADMIN_PASSWORD\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: JENKINS_ADMIN_PASSWORD\r\n\r\n    #####################################################\r\n    # GitHub (Application Repository)\r\n    #####################################################\r\n\r\n    - name: GITHUB_USERNAME\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: GITHUB_USERNAME\r\n\r\n    - name: GITHUB_TOKEN\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: GITHUB_TOKEN\r\n\r\n    #####################################################\r\n    # GitOps Repository\r\n    #####################################################\r\n\r\n    - name: GITOPS_USERNAME\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: GITOPS_USERNAME\r\n\r\n    - name: GITOPS_TOKEN\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: GITOPS_TOKEN\r\n\r\n    #####################################################\r\n    # DockerHub\r\n    #####################################################\r\n\r\n    - name: DOCKERHUB_USERNAME\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: DOCKERHUB_USERNAME\r\n\r\n    - name: DOCKERHUB_PASSWORD\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: DOCKERHUB_PASSWORD\r\n\r\n    #####################################################\r\n    # SonarQube\r\n    #####################################################\r\n\r\n    - name: SONAR_TOKEN\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: SONAR_TOKEN\r\n\r\n    #####################################################\r\n    # SMTP\r\n    #####################################################\r\n\r\n    - name: SMTP_USERNAME\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: SMTP_USERNAME\r\n\r\n    - name: SMTP_PASSWORD\r\n      valueFrom:\r\n        secretKeyRef:\r\n          name: jenkins-secrets\r\n          key: SMTP_PASSWORD\r\n\r\n#########################################################\r\n# Jenkins Agent\r\n#########################################################\r\n\r\nagent:\r\n\r\n  enabled: false\r\n\r\n#########################################################\r\n# RBAC\r\n#########################################################\r\n\r\nrbac:\r\n\r\n  create: false\r\n\r\n#########################################################\r\n# Service Account\r\n#########################################################\r\n\r\nserviceAccount:\r\n\r\n  create: false\r\n\r\n  name: jenkins\r\n\r\n#########################################################\r\n# Network Policy\r\n#########################################################\r\n\r\nnetworkPolicy:\r\n\r\n  enabled: false\r\n\r\n#########################################################\r\n# Persistence\r\n#########################################################\r\n\r\npersistence:\r\n\r\n  enabled: false"
            ],
